{
  "uid": "api-libros",
  "title": "API de libros",
  "tags": [
    "api-libros"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Requests in the last hour", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(api_http_request_duration_seconds_count[1h]))", "legendFormat": ""}]},
    {"id": 2, "type": "stat", "title": "Errors (4xx + 5xx) in the last hour", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}, "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(api_http_request_duration_seconds_count{status_code=~\"4..|5..\"}[1h])) or vector(0)", "legendFormat": ""}]},
    {"id": 3, "type": "stat", "title": "Memory used by the API", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}, "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "api_process_resident_memory_bytes", "legendFormat": ""}]},
    {"id": 4, "type": "stat", "title": "Slowest 5% of requests (p95)", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.3}, {"color": "red", "value": 1}]}}, "overrides": []}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(api_http_request_duration_seconds_bucket[5m])))", "legendFormat": ""}]},
    {"id": 5, "type": "timeseries", "title": "Requests per second, by route", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (method, route) (rate(api_http_request_duration_seconds_count[1m]))", "legendFormat": "{{method}} {{route}}"}]},
    {"id": 6, "type": "timeseries", "title": "Requests per second, by status code", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (status_code) (rate(api_http_request_duration_seconds_count[1m]))", "legendFormat": "{{status_code}}"}]},
    {"id": 7, "type": "timeseries", "title": "Response time p95, by route", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.95, sum by (le, route) (rate(api_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]},
    {"id": 8, "type": "timeseries", "title": "Memory and event loop lag", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": [{"matcher": {"id": "byName", "options": "event loop lag p99"}, "properties": [{"id": "unit", "value": "s"}, {"id": "custom.axisPlacement", "value": "right"}]}]}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "api_process_resident_memory_bytes", "legendFormat": "memory"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "api_nodejs_eventloop_lag_p99_seconds", "legendFormat": "event loop lag p99"}]}
  ]
}
